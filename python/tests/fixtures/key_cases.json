  "combos": [
    { "why": "最常见的一对", "in": "Ctrl+C", "out": ["ctrl", "c"] },
    { "why": "全小写", "in": "ctrl+c", "out": ["ctrl", "c"] },
    { "why": "全大写", "in": "CTRL+C", "out": ["ctrl", "c"] },
    { "why": "Control 是 ctrl 的别名（Electron 语汇里也这么写）", "in": "Control+V", "out": ["ctrl", "v"] },
    { "why": "多余空格不该变成错误", "in": " Ctrl + C ", "out": ["ctrl", "c"] },
    { "why": "两个修饰键", "in": "Ctrl+Shift+C", "out": ["ctrl", "shift", "c"] },
    { "why": "写反了也要归一到同一个串，否则「同一个快捷键」会变成两个", "in": "Shift+Ctrl+C", "out": ["ctrl", "shift", "c"] },
    { "why": "Alt 组合", "in": "Alt+F4", "out": ["alt", "f4"] },
    { "why": "Win 键", "in": "Win+R", "out": ["win", "r"] },
