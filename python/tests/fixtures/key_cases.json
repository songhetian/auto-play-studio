    { "why": "方向键别名", "in": "ArrowLeft", "out": ["left"] },
    { "why": "空段一律丢掉，所以 ++ 和 + 等价 —— 想按加号得写 plus", "in": "Ctrl++C", "out": ["ctrl", "c"] },
    { "why": "数组形态同样丢掉空段，与字符串形态口径一致", "in": ["Ctrl", "", "C"], "out": ["ctrl", "c"] }
