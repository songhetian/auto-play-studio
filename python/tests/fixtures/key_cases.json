    { "why": "三键组合", "in": "ctrl+alt+delete", "out": ["ctrl", "alt", "delete"] },
    { "why": "pyautogui 支持多键同时按下，所以这是合法的", "in": "Ctrl+C+V", "out": ["ctrl", "c", "v"] },
