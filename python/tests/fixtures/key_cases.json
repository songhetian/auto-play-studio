    "alt": ["alt", "option"],
    "shift": ["shift"],
    "win": ["win", "winleft", "super", "cmd", "command", "meta"],
    "enter": ["enter", "return"],
    "escape": ["escape", "esc"],
    "tab": ["tab"],
